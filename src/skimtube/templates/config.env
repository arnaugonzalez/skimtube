# skimtube configuration. Environment variables override these values.
# Relative paths are resolved against the working directory (--dir, default: cwd).

# --- LLM: any OpenAI-compatible endpoint -----------------------------------
# OpenAI:      SKIMTUBE_LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:  SKIMTUBE_LLM_BASE_URL=https://openrouter.ai/api/v1
# DeepSeek:    SKIMTUBE_LLM_BASE_URL=https://api.deepseek.com/v1
# Ollama:      SKIMTUBE_LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
SKIMTUBE_LLM_BASE_URL=https://openrouter.ai/api/v1
SKIMTUBE_LLM_MODEL=
# Prefer exporting the key in your shell or a secrets manager over writing it here.
# SKIMTUBE_LLM_API_KEY=

# Or pipe prompts through any CLI that reads stdin and prints the answer:
# SKIMTUBE_LLM_PROVIDER=command
# Transcripts are untrusted text: give agent CLIs no tools, or a video can make them run commands.
# SKIMTUBE_LLM_COMMAND=claude -p --tools "" --strict-mcp-config

# --- Output -----------------------------------------------------------------
SKIMTUBE_OUT=knowledge-feed
SKIMTUBE_SUMMARY_LANG=English
# Videos outside this topic get skipped by the LLM. Empty = keep everything.
SKIMTUBE_TOPIC=technology and AI

# --- Collection -------------------------------------------------------------
SKIMTUBE_CHANNELS=channels.txt
SKIMTUBE_BLOCKLIST=blocklist.txt
SKIMTUBE_STATE=state.json
# Subtitle languages, tried one at a time (native language first avoids 429s).
SKIMTUBE_SUB_LANGS=en,en-orig,en-US
# First run only: how far back to look.
SKIMTUBE_LOOKBACK_HOURS=24
SKIMTUBE_MAX_PER_RUN=25
SKIMTUBE_MAX_TRANSCRIPT_CHARS=48000
# Optional pre-filter on title + description (comma-separated, whole words).
# Cheaper than asking the LLM. Empty = no pre-filter.
# SKIMTUBE_KEYWORDS=ai,llm,agents,model,gpt,claude,gemini,llama,rag,inference
SKIMTUBE_KEYWORDS=
# Use a specific yt-dlp binary instead of the one installed with skimtube.
# SKIMTUBE_YTDLP_BIN=/usr/local/bin/yt-dlp
