# yt-collector configuration. Environment variables override these values.
# Relative paths are resolved against the working directory (--dir, default: cwd).

# --- LLM: any OpenAI-compatible endpoint -----------------------------------
# OpenAI:      YTC_LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:  YTC_LLM_BASE_URL=https://openrouter.ai/api/v1
# DeepSeek:    YTC_LLM_BASE_URL=https://api.deepseek.com/v1
# Ollama:      YTC_LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
YTC_LLM_BASE_URL=https://openrouter.ai/api/v1
YTC_LLM_MODEL=
# Prefer exporting the key in your shell or a secrets manager over writing it here.
# YTC_LLM_API_KEY=

# Or pipe prompts through any CLI that reads stdin and prints the answer:
# YTC_LLM_PROVIDER=command
# YTC_LLM_COMMAND=claude -p

# --- Output -----------------------------------------------------------------
YTC_OUT=knowledge-feed
YTC_SUMMARY_LANG=English
# Videos outside this topic get skipped by the LLM. Empty = keep everything.
YTC_TOPIC=technology and AI

# --- Collection -------------------------------------------------------------
YTC_CHANNELS=channels.txt
YTC_BLOCKLIST=blocklist.txt
YTC_STATE=state.json
# Subtitle languages, tried one at a time (native language first avoids 429s).
YTC_SUB_LANGS=en,en-orig,en-US
# First run only: how far back to look.
YTC_LOOKBACK_HOURS=24
YTC_MAX_PER_RUN=25
YTC_MAX_TRANSCRIPT_CHARS=48000
# Optional pre-filter on title + description (comma-separated, whole words).
# Cheaper than asking the LLM. Empty = no pre-filter.
# YTC_KEYWORDS=ai,llm,agents,model,gpt,claude,gemini,llama,rag,inference
YTC_KEYWORDS=
