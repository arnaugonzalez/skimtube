# crontab -e   — collect every 6 hours, digest once a day at 20:00.
# cron has a minimal environment: set the key here or in config.env.
SKIMTUBE_LLM_API_KEY=sk-...
0 */6 * * *  cd $HOME/kb && $HOME/.local/bin/skimtube run    >> run.log 2>&1
0 20 * * *   cd $HOME/kb && $HOME/.local/bin/skimtube digest >> run.log 2>&1
