# ~/.config/systemd/user/yt-collector.service
# Enable with: systemctl --user enable --now yt-collector.timer
[Unit]
Description=yt-collector: summarize new videos into the knowledge base
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/kb
# EnvironmentFile holds YTC_LLM_API_KEY=... (chmod 600)
EnvironmentFile=%h/.config/yt-collector/secrets.env
ExecStart=%h/.local/bin/yt-collector run
# Optional: publish the feed elsewhere after each run
# ExecStartPost=/usr/bin/rsync -az --delete %h/kb/knowledge-feed/ server:knowledge-feed/
TimeoutStartSec=3600
