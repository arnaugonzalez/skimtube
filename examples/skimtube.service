# ~/.config/systemd/user/skimtube.service
# Enable with: systemctl --user enable --now skimtube.timer
[Unit]
Description=skimtube: summarize new videos into the knowledge base
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/kb
# EnvironmentFile holds SKIMTUBE_LLM_API_KEY=... (chmod 600)
EnvironmentFile=%h/.config/skimtube/secrets.env
ExecStart=%h/.local/bin/skimtube run
# Optional: publish the feed elsewhere after each run
# ExecStartPost=/usr/bin/rsync -az --delete %h/kb/knowledge-feed/ server:knowledge-feed/
TimeoutStartSec=3600
